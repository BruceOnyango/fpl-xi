# Frontend build-time config. Copy to .env.local (gitignored). Vite inlines VITE_* at build
# time, so rebuild after changing anything here.

# false = call the real API. Production builds already default to false (.env.production).
VITE_USE_MOCKS=false

# The API's base URL. Default /fpl = same origin: nginx/Apache forwards /fpl → fpl-api :8011,
# and the dev/preview servers proxy it the same way. Only set an absolute URL if the app is
# served from a different origin than the API (then add that origin to the API's CORS_ORIGINS).
# VITE_API_BASE_URL=/fpl

# Dev/preview proxy target (not baked into the build).
# FPL_API_TARGET=http://127.0.0.1:8011
