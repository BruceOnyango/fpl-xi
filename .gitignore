# --- monorepo-level ---
/logs/
/brag*
.env
.env.*.local

# --- backend (Python) ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.pt
backend/data/raw/*.json
backend/data/processed/*.parquet
backend/data/processed/*.json

# frontend/ has its own .gitignore (node_modules, dist, …)

# Personal, machine-local files (deploy runbook, real proxy configs with your domain) — never committed
*.local.md
*.local.conf
/deploy*
*/.DEPLOYMENT.md
# Deployment files: keep on this machine only
/deploy/
/DEPLOYMENT.md
