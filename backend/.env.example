# Backend runtime config. Copy to backend/.env (gitignored); ecosystem.config.js loads it.
# Bind address/port for uvicorn. nginx/Apache forwards /fpl/ here.
API_HOST=127.0.0.1
API_PORT=8011
# Every route lives under this prefix (public entry: https://example.com/fpl).
FPL_API_PREFIX=/fpl
# Browser origins allowed by CORS (comma-separated). Same-origin via nginx needs none,
# but direct access to the web app on :3011 does.
CORS_ORIGINS=http://localhost:3011
# Production: add your site, e.g. CORS_ORIGINS=https://example.com,http://localhost:3011
# Optional: serve predictions/backtests from somewhere other than backend/data/processed.
# FPL_XI_PROCESSED_DIR=/srv/fpl-xi/backend/data/processed
# Optional: shown by /fpl/health. CI/deploy can set it to the git SHA.
# APP_VERSION=
# Optional: only for `predict_upcoming.py --squad-image`.
# ANTHROPIC_API_KEY=
